 <style>
        /* ----- CRITICAL STYLES (optimized) ----- */
        *{margin:0;padding:0;box-sizing:border-box}
        body{background:#030303;font-family:'Plus Jakarta Sans',sans-serif;color:#ededed;overflow-x:hidden}
        .bg-glow{position:fixed;top:0;left:0;width:100%;height:100%;background:radial-gradient(circle at 70% 20%,rgba(255,200,50,0.05),#000 90%);pointer-events:none;z-index:0}
        .main-container{position:relative;z-index:2;max-width:1440px;margin:0 auto;padding:30px 28px 70px}
        .hero-category{text-align:center;margin-bottom:55px}
        .hero-category .chip{display:inline-block;background:rgba(255,200,70,0.12);border:.6px solid rgba(255,200,70,0.5);padding:6px 20px;border-radius:60px;font-size:.8rem;font-weight:600;text-transform:uppercase;letter-spacing:1.8px;color:#ffdf80;margin-bottom:20px}
        .hero-category h1{font-size:clamp(2.8rem,8vw,5.2rem);font-weight:800;background:linear-gradient(145deg,#fff,#FFDF8C,#F5BC2E);background-clip:text;-webkit-background-clip:text;color:transparent;margin-bottom:12px}
        .hero-sub{font-size:1.05rem;font-weight:400;color:#b9b9c3;border-top:1px solid rgba(255,200,70,0.3);display:inline-block;padding-top:14px}
        .grid-awards{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:30px}
        .award-card{background:rgba(14,14,20,0.9);border-radius:32px;overflow:hidden;transition:transform .3s,border-color .2s;border:1px solid rgba(255,215,0,0.22);box-shadow:0 20px 35px -12px rgba(0,0,0,0.6);display:flex;flex-direction:column}
        .award-card:hover{transform:translateY(-8px);border-color:rgba(255,210,60,0.9);background:rgba(22,22,30,0.95)}
        .card-media{width:100%;height:290px;overflow:hidden;position:relative;background:#1a1a24}
        .card-media img{width:100%;height:100%;object-fit:cover;transition:transform .5s,opacity .3s;opacity:0}
        .card-media img.loaded{opacity:1}
        .award-card:hover .card-media img{transform:scale(1.05)}
        .card-media::after{content:"";position:absolute;bottom:0;left:0;width:100%;height:50%;background:linear-gradient(to top,rgba(0,0,0,0.7),transparent);pointer-events:none}
        .loading-spinner{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:30px;height:30px;border:3px solid rgba(255,215,0,0.3);border-top-color:#f5bc2e;border-radius:50%;animation:spin .8s linear infinite}
        @keyframes spin{to{transform:translate(-50%,-50%) rotate(360deg)}}
        .card-body{padding:22px 22px 28px;text-align:center}
        .icon-cat{font-size:2rem;color:#f5c542;margin-bottom:8px}
        .card-body h3{font-size:1.45rem;font-weight:700;margin:10px 0 8px;background:linear-gradient(125deg,#fff,#ffe0a3);background-clip:text;-webkit-background-clip:text;color:transparent}
        .card-body p{font-size:.86rem;line-height:1.45;color:#c9c9d4;margin:10px 0 22px}
        .nominate-btn{display:inline-flex;align-items:center;gap:10px;background:linear-gradient(105deg,#e0b13a,#ffdc73);color:#0b0b0b;border:none;padding:10px 28px;border-radius:50px;font-weight:800;font-size:.82rem;text-transform:uppercase;text-decoration:none;transition:.2s;cursor:pointer}
        .nominate-btn:hover{background:linear-gradient(105deg,#ffcf54,#ffea9e);transform:scale(1.02)}
        .accent-line{width:52px;height:2px;background:linear-gradient(90deg,#f5bc2e,#b57a1a);margin:18px auto 0;border-radius:4px}
        .popup{display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.95);backdrop-filter:blur(6px);justify-content:center;align-items:center;z-index:9999}
        .popup-content{background:#111217;padding:30px 28px;border-radius:32px;width:450px;max-width:90%;max-height:85vh;overflow-y:auto;border:1px solid rgba(255,200,70,0.4);position:relative}
        .close-btn{position:absolute;right:22px;top:18px;font-size:28px;cursor:pointer;color:#ffdf80}
        .popup-content h2{font-size:1.8rem;margin-bottom:20px;color:#ffdf80;text-align:center}
        .popup-content input,.popup-content textarea{width:100%;padding:12px 15px;margin-bottom:16px;background:#1e1e2a;border:1px solid #333;border-radius:40px;color:#fff;font-family:inherit;outline:none}
        .popup-content input:focus,.popup-content textarea:focus{border-color:#f5bc2e}
        .popup-content textarea{border-radius:24px;resize:vertical;min-height:80px}
        .popup-content button{background:linear-gradient(105deg,#e0b13a,#ffdc73);border:none;padding:12px;width:100%;border-radius:40px;font-weight:bold;font-size:1rem;cursor:pointer;margin-top:8px;transition:.2s}
        .popup-content button:hover{transform:scale(0.98)}
        .photo-note{background:rgba(245,188,46,0.1);border-left:3px solid #f5bc2e;padding:10px 15px;margin-top:15px;border-radius:8px;font-size:.8rem;color:#ffdf80;text-align:center}
        
        /* Header / Offcanvas styles */
        .container-fluid{padding:0 30px}
        .header-main{display:flex;justify-content:space-between;align-items:center;padding:18px 0;border-bottom:1px solid rgba(255,200,70,0.2)}
        .logo img{width:110px}
        .main-menu ul{display:flex;list-style:none;gap:30px}
        .main-menu ul li a{color:#f0f0f0;text-decoration:none;font-weight:500;transition:.2s}
        .main-menu ul li a:hover{color:#f5bc2e}
        .header-button .gt-theme-btn{background:linear-gradient(105deg,#e0b13a,#ffdc73);padding:8px 22px;border-radius:40px;font-weight:700;text-decoration:none;color:#0b0b0b;display:inline-block}
        .header-right{display:flex;align-items:center;gap:20px}
        .sidebar__toggle{font-size:26px;cursor:pointer;color:#ffdf80;margin-left:20px}
        /* HIDE TOGGLE BUTTON ON DESKTOP (≥992px) */
        @media (min-width:992px){.sidebar__toggle{display:none}}
        
        .offcanvas__info{position:fixed;top:0;right:-100%;width:380px;height:100%;background:#0a0a10;z-index:100000;transition:right .35s ease;padding:30px 24px;box-shadow:-5px 0 30px rgba(0,0,0,0.8)}
        .offcanvas__info.active{right:0}
        .offcanvas__overlay{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.7);z-index:99999;opacity:0;visibility:hidden;transition:.25s}
        .offcanvas__overlay.active{opacity:1;visibility:visible}
        .offcanvas__close button{background:none;border:none;font-size:28px;color:#ffdf80;cursor:pointer}
        footer{background:#050507;padding:60px 0 20px;margin-top:70px;border-top:1px solid rgba(255,200,70,0.2)}
        .gt-footer-widget-wrapper .row{display:flex;flex-wrap:wrap;gap:30px}
        .gt-footer-widget-items{flex:1;min-width:200px}
        .gt-list-area{list-style:none}
        .gt-list-area li a{color:#ccc;text-decoration:none;line-height:2}
        .footer-bottom{text-align:center;padding-top:30px;margin-top:40px;border-top:1px solid #222}
        .footer-wrapper{display:flex;justify-content:space-between;flex-wrap:wrap;gap:15px}
        .gt-social-icon{display:flex;gap:15px;margin-top:15px}
        .gt-social-icon a{color:#ccc;font-size:1.2rem}
        .gt-back-to-top{position:fixed;bottom:30px;right:30px;background:#f5bc2e;width:45px;height:45px;border-radius:50%;display:none;align-items:center;justify-content:center;cursor:pointer;border:none;z-index:99;color:#000;font-size:1.2rem}
        @media (max-width:992px){.main-menu{display:none}.container-fluid{padding:0 20px}}
        @media (max-width:700px){.main-container{padding:20px 16px 50px}.offcanvas__info{width:100%}}
        .success-msg,.error-msg{position:fixed;top:20px;left:50%;transform:translateX(-50%);padding:12px 24px;border-radius:50px;font-weight:bold;z-index:10000;animation:slideDown .3s ease}
        .success-msg{background:#10b981;color:#fff}
        .error-msg{background:#ef4444;color:#fff}
        @keyframes slideDown{from{top:-50px;opacity:0}to{top:20px;opacity:1}}
    </style>